rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        match /buildings/{document} {

            allow read, write: if true;

        }


        match /locations/{document} {

            allow read, write: if true;

        }


        match /routes/{document} {

            allow read, write: if true;

        }


        match /settings/{document} {

            allow read, write: if true;

        }

    }

}